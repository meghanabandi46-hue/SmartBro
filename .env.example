# Copy to .env for local development. Never commit your real .env.
# In production, set FLASK_ENV=production and a strong random SECRET_KEY.
SECRET_KEY=
FLASK_ENV=development
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0

# Choose exactly one database. The app will not silently fall back.
DB_ENGINE=sqlite
SQLITE_PATH=database/udaan.db

# Used only when DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=udaan_app
MYSQL_PASSWORD=
MYSQL_DATABASE=udaan_db

PORT=5000
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
