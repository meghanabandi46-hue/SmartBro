# UDAAN Environment Configuration Template
# Copy this file to .env and adjust your local credentials.

# Flask Security Secret Key
SECRET_KEY=udaan-secure-local-dev-key-change-in-prod-2026

# Database Engine: 'auto' (tries MySQL, falls back to SQLite), 'mysql', or 'sqlite'
DB_ENGINE=auto

# MySQL Configuration (Primary)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=udaan_db

# Flask Server Port
PORT=5000
FLASK_DEBUG=1
